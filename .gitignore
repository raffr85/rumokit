# Reduce accidental inclusion; a complete file and diff review remains mandatory.
# Private experiments, run outputs, logs, and mutable state stay outside the package.
# Reviewed synthetic public scenarios may live in tests/scenarios/.

# Experiment and evaluation artifacts
/lab/
/runs/
/results/
/experiments/
/evals/
*.log
*.jsonl

# Local state reserved for a possible future implementation
/.rumokit/
# Keep legacy local state out of the renamed package too.
/.steelman/

# Development residue
node_modules/
__pycache__/
.venv/
.env
.DS_Store
